{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ricochet-public-research:record:1.0.0",
  "title": "RICOCHET research JSONL record",
  "description": "Apply this schema to each decoded JSONL line; cross-record citation integrity is checked by tools/validate.py.",
  "oneOf": [
    {"$ref": "#/$defs/meta"},
    {"$ref": "#/$defs/source"},
    {"$ref": "#/$defs/claim"}
  ],
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"},
    "text": {"type": "string", "minLength": 1},
    "claim_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^C[0-9]{3}$"}
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "revision", "researched_on", "subject", "scope", "completeness", "reading_order", "statuses", "source_count", "claim_count"],
      "properties": {
        "type": {"const": "meta"},
        "schema_version": {"const": "1.0.0"},
        "revision": {"type": "integer", "minimum": 1},
        "researched_on": {"$ref": "#/$defs/date"},
        "subject": {"$ref": "#/$defs/text"},
        "scope": {"$ref": "#/$defs/text"},
        "completeness": {"$ref": "#/$defs/text"},
        "reading_order": {"$ref": "#/$defs/text"},
        "statuses": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/text"}},
        "source_count": {"type": "integer", "minimum": 0},
        "claim_count": {"type": "integer", "minimum": 0},
        "subset": {"const": true},
        "parent_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "matched_claim_ids": {"$ref": "#/$defs/claim_ids"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "published", "accessed", "kind", "title", "url", "reviewed_sections", "note"],
      "properties": {
        "type": {"const": "source"},
        "id": {"type": "string", "pattern": "^S[0-9]{2}$"},
        "published": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "accessed": {"$ref": "#/$defs/date"},
        "kind": {"enum": ["vendor_primary", "vendor_research", "vendor_policy", "hardware_vendor_primary", "platform_primary", "independent_artifact", "independent_research", "academic_primary"]},
        "title": {"$ref": "#/$defs/text"},
        "url": {"type": "string", "pattern": "^https://"},
        "reviewed_sections": {"$ref": "#/$defs/text"},
        "note": {"type": "string"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "topic", "status", "as_of", "scope", "text", "sources", "locator"],
      "properties": {
        "type": {"const": "claim"},
        "id": {"type": "string", "pattern": "^C[0-9]{3}$"},
        "topic": {"type": "string", "pattern": "^[a-z_]+$"},
        "status": {"enum": ["official_statement", "qualified_interpretation", "platform_context", "independent_observation", "inference", "unknown"]},
        "as_of": {"$ref": "#/$defs/date"},
        "scope": {"$ref": "#/$defs/text"},
        "text": {"$ref": "#/$defs/text"},
        "sources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{2}$"}},
        "locator": {"$ref": "#/$defs/text"},
        "basis_claims": {"$ref": "#/$defs/claim_ids"},
        "updates": {"$ref": "#/$defs/claim_ids"},
        "contrasts_with": {"$ref": "#/$defs/claim_ids"}
      },
      "if": {"properties": {"status": {"const": "unknown"}}},
      "then": {"required": ["basis_claims"], "properties": {"sources": {"maxItems": 0}, "basis_claims": {"minItems": 1}}},
      "else": {"properties": {"sources": {"minItems": 1}}}
    }
  }
}
