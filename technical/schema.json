{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ricochet-public-research:mw4-warzone-technical:1.0",
  "title": "MW4/Warzone focused technical JSONL record",
  "description": "Core source-supported records plus hash-identified static diagnostic observations. Not a private game implementation specification.",
  "oneOf": [
    {
      "$ref": "#/$defs/meta"
    },
    {
      "$ref": "#/$defs/source"
    },
    {
      "$ref": "#/$defs/claim"
    },
    {
      "$ref": "#/$defs/artifact_source"
    },
    {
      "$ref": "#/$defs/static_claim"
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[CT][0-9]{3}$"
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "revision",
        "researched_on",
        "subject",
        "scope",
        "completeness",
        "reading_order",
        "statuses",
        "source_count",
        "claim_count",
        "core_claim_count",
        "static_observation_count",
        "artifact_source_count"
      ],
      "properties": {
        "type": {
          "const": "meta"
        },
        "schema_version": {
          "const": "mw4-warzone-technical-1.0"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "researched_on": {
          "$ref": "#/$defs/date"
        },
        "subject": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "completeness": {
          "$ref": "#/$defs/text"
        },
        "reading_order": {
          "$ref": "#/$defs/text"
        },
        "statuses": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "source_count": {
          "type": "integer",
          "minimum": 0
        },
        "claim_count": {
          "type": "integer",
          "minimum": 0
        },
        "subset": {
          "const": true
        },
        "parent_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "matched_claim_ids": {
          "$ref": "#/$defs/claim_ids"
        },
        "core_claim_count": {
          "type": "integer",
          "minimum": 0
        },
        "static_observation_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_source_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "published",
        "accessed",
        "kind",
        "title",
        "url",
        "reviewed_sections",
        "note",
        "verification"
      ],
      "properties": {
        "type": {
          "const": "source"
        },
        "id": {
          "type": "string",
          "pattern": "^S[0-9]{2}$"
        },
        "published": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "accessed": {
          "$ref": "#/$defs/date"
        },
        "kind": {
          "enum": [
            "vendor_primary",
            "vendor_research",
            "vendor_policy",
            "hardware_vendor_primary",
            "platform_primary",
            "independent_artifact",
            "independent_research",
            "academic_primary"
          ]
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "reviewed_sections": {
          "$ref": "#/$defs/text"
        },
        "note": {
          "type": "string"
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "response_sha256",
            "normalized_text_sha256",
            "paragraph_count",
            "checked_on",
            "truncated"
          ],
          "properties": {
            "method": {
              "enum": [
                "direct_https",
                "publisher_oembed"
              ]
            },
            "response_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "normalized_text_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "paragraph_count": {
              "type": "integer",
              "minimum": 1
            },
            "checked_on": {
              "$ref": "#/$defs/date"
            },
            "truncated": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "topic",
        "status",
        "as_of",
        "scope",
        "text",
        "sources",
        "locator",
        "verification"
      ],
      "properties": {
        "type": {
          "const": "claim"
        },
        "id": {
          "type": "string",
          "pattern": "^C[0-9]{3}$"
        },
        "topic": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "status": {
          "enum": [
            "official_statement",
            "platform_context",
            "artifact_statement",
            "study_report"
          ]
        },
        "as_of": {
          "$ref": "#/$defs/date"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "minItems": 1
        },
        "locator": {
          "$ref": "#/$defs/text"
        },
        "basis_claims": {
          "$ref": "#/$defs/claim_ids"
        },
        "updates": {
          "$ref": "#/$defs/claim_ids"
        },
        "contrasts_with": {
          "$ref": "#/$defs/claim_ids"
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "checked_on",
            "evidence"
          ],
          "properties": {
            "result": {
              "const": "source_statement_supported"
            },
            "checked_on": {
              "$ref": "#/$defs/date"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "paragraphs"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^S[0-9]{2}$"
                  },
                  "paragraphs": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^P[0-9]{4}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "artifact_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "kind",
        "title",
        "url",
        "accessed",
        "published",
        "scope_source",
        "archive",
        "executable_sha256",
        "components",
        "report",
        "report_sha256",
        "note"
      ],
      "properties": {
        "type": {
          "const": "source"
        },
        "id": {
          "const": "A01"
        },
        "kind": {
          "const": "vendor_diagnostic_artifact"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "accessed": {
          "$ref": "#/$defs/date"
        },
        "published": {
          "$ref": "#/$defs/date"
        },
        "scope_source": {
          "type": "string",
          "pattern": "^S[0-9]{2}$"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "sha256",
            "bytes",
            "members"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "members": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256",
              "bytes"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "report": {
          "type": "string",
          "minLength": 1
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "static_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "topic",
        "status",
        "as_of",
        "scope",
        "text",
        "sources",
        "locator",
        "verification"
      ],
      "properties": {
        "type": {
          "const": "claim"
        },
        "id": {
          "type": "string",
          "pattern": "^T[0-9]{3}$"
        },
        "topic": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "status": {
          "const": "static_observation"
        },
        "as_of": {
          "$ref": "#/$defs/date"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(S[0-9]{2}|A01)$"
          }
        },
        "locator": {
          "$ref": "#/$defs/text"
        },
        "basis_claims": {
          "$ref": "#/$defs/claim_ids"
        },
        "updates": {
          "$ref": "#/$defs/claim_ids"
        },
        "contrasts_with": {
          "$ref": "#/$defs/claim_ids"
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "checked_on",
            "artifact",
            "report",
            "evidence"
          ],
          "properties": {
            "result": {
              "const": "static_file_content_observed"
            },
            "checked_on": {
              "$ref": "#/$defs/date"
            },
            "artifact": {
              "const": "A01"
            },
            "report": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "report_pointer"
                ],
                "properties": {
                  "report_pointer": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "expected": {},
                  "contains": {
                    "type": "array",
                    "minItems": 1
                  },
                  "absent": {
                    "type": "array",
                    "minItems": 1
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "expected"
                    ]
                  },
                  {
                    "required": [
                      "contains"
                    ]
                  },
                  {
                    "required": [
                      "absent"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
